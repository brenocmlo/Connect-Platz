// Prisma Schema para Connect Platz CRM & ERP (Robson Carvalho CRM CONNECT PLATZ)
// Suporte nativo a PostgreSQL com Row Level Security (RLS) habilitado

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// ENUMS DO SISTEMA
// ----------------------------------------------------

enum Role {
  ADMINISTRADOR
  DIRETOR
  GERENTE
  CORRETOR
}

enum CorretorStatus {
  DISPONIVEL
  EM_VISITA
  PAUSA
  OFFLINE
}

enum LeadTemperature {
  FRIO
  MORNO
  QUENTE
}

enum LeadSource {
  META_ADS
  GOOGLE_ADS
  MANUAL_CORRETOR
  CATALOGO_SITE
  INDICACAO
  PORTAL_IMOBILIARIO
}

enum CreditEmploymentType {
  CLT
  AUTONOMO
  EMPRESARIO
  APOSENTADO_PENSIONISTA
  OUTRO
}

enum CreditAnalysisStatus {
  NAO_INICIADA
  EM_ANALISE
  DOCUMENTACAO_PENDENTE
  APROVADO
  REPROVADO
  CONDICIONADO
}

enum PropertyModality {
  VENDA
  VERANEIO_TEMPORADA
  AMBOS
}

enum PriceRange {
  ECONOMICO
  MEDIO
  ALTO_PADRAO
  LUXO_FRENTE_MAR
}

enum UnitStatus {
  DISPONIVEL
  RESERVADA
  VENDIDA
  BLOQUEADA
}

enum PaymentMethod {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TED
}

enum BookingStatus {
  PENDENTE
  CONFIRMADA
  CANCELADA
  CONCLUIDA
}

enum CommissionBeneficiaryType {
  IMOBILIARIA
  DIRETOR
  GERENTE
  CORRETOR_TITULAR
  CO_CORRETOR
  CAPTACAO
  PARCEIRO_EXTERNO
}

enum PaymentStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum CashFlowType {
  RECEITA
  DESPESA
}

enum AppointmentType {
  VISITA
  RETORNO_FOLLOWUP
  REUNIAO
  LIGACAO
  APRESENTACAO_PROPOSTA
  ASSINATURA_CONTRATO
  ENTREGA_CHAVES
  PLANTAO_VENDAS
}

enum AppointmentStatus {
  AGENDADO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

// ----------------------------------------------------
// ENTIDADES PRINCIPAIS
// ----------------------------------------------------

// Organização (Multi-tenant)
model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  nome            String
  slug            String   @unique
  cnpj            String?
  creci           String?
  logoUrl         String?
  logoDarkUrl     String?
  primaryColor    String   @default("#1266C7")
  secondaryColor  String   @default("#D9BB4C")
  bolsaoEnabled   Boolean  @default(true)
  bolsaoTimeoutMin Int     @default(20) // Minutos para transbordo automático
  operatingStart  String   @default("09:00")
  operatingEnd    String   @default("22:00")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  funnels         Funnel[]
  leads           Lead[]
  properties      Property[]
  bookings        SeasonBooking[]
  sales           Sale[]
  cashFlows       CashFlow[]
  appointments    Appointment[]
  auditLogs       AuditLog[]

  @@map("organizations")
}

// Usuários do Sistema
model User {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @db.Uuid
  nome                String
  email               String         @unique
  passwordHash        String         // Hasheado com bcrypt (salt rounds >= 12)
  telefone            String?
  creci               String?
  photoUrl            String?
  role                Role           @default(CORRETOR)
  status              CorretorStatus @default(OFFLINE)
  isActive            Boolean        @default(true)
  lastLeadAssignedAt  DateTime?      // Utilizado pelo algoritmo Round-Robin
  dailyCheckInAt      DateTime?      // Data/Hora do último check-in diário
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads               Lead[]         @relation("CorretorLeads")
  timelineEntries     LeadTimeline[]
  checkIns            CheckIn[]
  bookings            SeasonBooking[] @relation("CorretorBookings")
  salesAsTitular      Sale[]         @relation("CorretorSales")
  commissions         CommissionSplit[]
  appointments        Appointment[]
  auditLogs           AuditLog[]

  @@index([organizationId, role, status])
  @@index([organizationId, lastLeadAssignedAt])
  @@map("users")
}

// Histórico de Check-in Diário de Presença dos Corretores
model CheckIn {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  date           DateTime  @db.Date // Data do dia (YYYY-MM-DD)
  checkedInAt    DateTime  @default(now())
  userIp         String?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("check_ins")
}

// Funis de Vendas
model Funnel {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  nome            String
  isDefault       Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages          FunnelStage[]
  leads           Lead[]

  @@map("funnels")
}

// Etapas do Funil (Colunas do Kanban)
model FunnelStage {
  id              String        @id @default(uuid()) @db.Uuid
  funnelId        String        @db.Uuid
  nome            String
  posicao         Int
  cor             String        @default("#64748B")
  slaMinutes      Int?          // Tempo máximo de permanência nesta etapa
  actionOnExpire  String        @default("transbordo") // "transbordo", "bolsao" ou "notificar"
  createdAt       DateTime      @default(now())

  funnel          Funnel        @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  leads           Lead[]

  @@index([funnelId, posicao])
  @@map("funnel_stages")
}

// Prontuário Completo do Lead
model Lead {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @db.Uuid
  funnelId                String                @db.Uuid
  stageId                 String                @db.Uuid
  corretorId              String?               @db.Uuid

  // Dados Básicos
  nome                    String
  telefone                String                // Mascarado para outros corretores
  email                   String?
  cpf                     String?
  rg                      String?
  dataNascimento          DateTime?             @db.Date
  estadoCivil             String?               // Solteiro, Casado, etc.
  regimeCasamento         String?
  profissao               String?
  bairrosInteresse        String[]

  // Qualificação Financeira & Esteira de Crédito Bancário
  rendaDeclarada          Decimal?              @db.Decimal(12, 2)
  rendaInformal           Decimal?              @db.Decimal(12, 2)
  faixaRenda              String?               // Até 3 SM, 3 a 5 SM, 5 a 10 SM, etc.
  tipoOcupacaoCredito     CreditEmploymentType?
  rendaEspecificaAutonomo Decimal?              @db.Decimal(12, 2) // Campo obrigatório para autônomos
  statusCredito           CreditAnalysisStatus  @default(NAO_INICIADA)

  // Metadados Comerciais & SLA
  temperatura             LeadTemperature       @default(FRIO)
  source                  LeadSource            @default(META_ADS)
  adId                    String?
  formId                  String?
  campaignName            String?
  adName                  String?
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  utmContent              String?

  // SLA & Mecânica de Roleta / Bolsão / Transbordo
  firstContactAt          DateTime?
  slaDueAt                DateTime?             // Timestamp de estouro do SLA
  slaBreached             Boolean               @default(false)
  isBolsao                Boolean               @default(false)
  bolsaoEnteredAt         DateTime?
  isNightQueue            Boolean               @default(false) // Retido na fila noturna
  isClosed                Boolean               @default(false) // Lead arquivado por caducidade
  closedAt                DateTime?

  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  funnel                  Funnel                @relation(fields: [funnelId], references: [id], onDelete: Restrict)
  stage                   FunnelStage           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  corretor                User?                 @relation("CorretorLeads", fields: [corretorId], references: [id], onDelete: SetNull)

  timeline                LeadTimeline[]
  documents               LeadDocument[]
  sales                   Sale[]
  bookings                SeasonBooking[]
  appointments            Appointment[]

  @@index([organizationId, corretorId])
  @@index([organizationId, isBolsao])
  @@index([organizationId, isClosed])
  @@index([organizationId, createdAt])
  @@map("leads")
}

// Linha do Tempo e Interações do Lead (Mensagens, Áudios, Mudanças de Etapa)
model LeadTimeline {
  id              String        @id @default(uuid()) @db.Uuid
  leadId          String        @db.Uuid
  userId          String?       @db.Uuid
  tipo            String        // "nota", "whatsapp_print", "audio", "transbordo", "status_change", "visita"
  conteudo        String?       @db.Text
  audioUrl        String?
  duracaoSegundos Int?
  metadata        Json?
  createdAt       DateTime      @default(now())

  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_timeline")
}

// Central de Documentos do Lead
model LeadDocument {
  id              String        @id @default(uuid()) @db.Uuid
  leadId          String        @db.Uuid
  tipo            String        // "identidade", "holerite_clt", "extrato_irpf_autonomo", "comprovante_residencia", "certidao"
  nomeArquivo     String
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  createdAt       DateTime      @default(now())

  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_documents")
}

// Catálogo de Imóveis (Vendas e Aluguel de Veraneio)
model Property {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  nome            String
  slug            String
  tipoCadastro    String            @default("EMPREENDIMENTO") // "EMPREENDIMENTO" ou "AVULSO"
  exibirNaLandingPage Boolean       @default(true) // Exibir na vitrine do portal público
  modalidade      PropertyModality  @default(VENDA)
  faixaPreco      PriceRange        @default(MEDIO)
  estagioObra     String?           // lancamento, em_obras, pronto
  valorVenda      Decimal?          @db.Decimal(14, 2)
  valorDiaria     Decimal?          @db.Decimal(12, 2) // Para aluguel de veraneio
  taxaLimpeza     Decimal?          @db.Decimal(10, 2)
  endereco        String?
  bairro          String?
  cidade          String?
  estado          String?
  zona            String?
  descricao       String?           @db.Text
  fotos           String[]          // Até 25 URLs
  caracteristicas Json?             // quartos, suites, banheiros, vagas, area_m2
  diferenciais    String[]          // Piscina, Churrasqueira, Frente Mar, etc.
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units           PropertyUnit[]
  bookings        SeasonBooking[]
  sales           Sale[]
  appointments    Appointment[]

  @@unique([organizationId, slug])
  @@index([organizationId, modalidade, faixaPreco])
  @@map("properties")
}

// Unidades de Empreendimentos (Espelho de Vendas)
model PropertyUnit {
  id              String            @id @default(uuid()) @db.Uuid
  propertyId      String            @db.Uuid
  bloco           String
  pavimento       String?
  numeroUnidade   String
  status          UnitStatus        @default(DISPONIVEL)
  valor           Decimal           @db.Decimal(14, 2)
  areaPrivativa   Decimal?          @db.Decimal(8, 2)
  reservadoAte    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sales           Sale[]

  @@index([propertyId, status])
  @@map("property_units")
}

// Aluguéis de Veraneio (Temporada) com Bloqueio de Calendário
model SeasonBooking {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  propertyId      String            @db.Uuid
  leadId          String            @db.Uuid
  corretorId      String?           @db.Uuid

  checkInDate     DateTime          @db.Date
  checkOutDate    DateTime          @db.Date
  totalNights     Int
  valorDiarias    Decimal           @db.Decimal(12, 2)
  taxaLimpeza     Decimal           @default(0) @db.Decimal(10, 2)
  valorTotal      Decimal           @db.Decimal(12, 2)

  meioPagamento   PaymentMethod     // PIX, Cartão, Boleto, etc. (Obrigatório)
  status          BookingStatus     @default(CONFIRMADA)
  observacoes     String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  lead            Lead              @relation(fields: [leadId], references: [id], onDelete: Restrict)
  corretor        User?             @relation("CorretorBookings", fields: [corretorId], references: [id], onDelete: SetNull)
  cashFlowEntries CashFlow[]

  @@index([propertyId, checkInDate, checkOutDate])
  @@index([organizationId, status])
  @@map("season_bookings")
}

// Fechamento de Vendas & Contratos
model Sale {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @db.Uuid
  codigoVenda         String            @unique
  leadId              String            @db.Uuid
  propertyId          String            @db.Uuid
  unitId              String?           @db.Uuid
  corretorId          String            @db.Uuid

  valorVendaVGV       Decimal           @db.Decimal(14, 2) // VGV Comercial
  valorAvaliacao      Decimal?          @db.Decimal(14, 2) // Valor de Avaliação Bancária
  valorComissaoTotal  Decimal           @db.Decimal(14, 2)
  percentualComissao  Decimal           @db.Decimal(5, 2)

  meioPagamento       PaymentMethod     @default(TED)
  status              String            @default("ativa") // ativa, cancelada
  statusComissao      String            @default("pendente") // pendente, parcial, paga
  dataVenda           DateTime          @db.Date
  contratoUrl         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead                Lead              @relation(fields: [leadId], references: [id], onDelete: Restrict)
  property            Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit                PropertyUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  corretorTitular     User              @relation("CorretorSales", fields: [corretorId], references: [id], onDelete: Restrict)

  commissionSplits    CommissionSplit[]
  cashFlowEntries     CashFlow[]

  @@index([organizationId, dataVenda])
  @@map("sales")
}

// Split de Comissões por Venda
model CommissionSplit {
  id                  String                    @id @default(uuid()) @db.Uuid
  saleId              String                    @db.Uuid
  beneficiarioTipo    CommissionBeneficiaryType
  userId              String?                   @db.Uuid // Se for membro da equipe
  nomeBeneficiario    String
  documentoPix        String?
  parcelaNumero       Int                       @default(1)
  totalParcelas       Int                       @default(1)
  valor               Decimal                   @db.Decimal(12, 2)
  percentual          Decimal?                  @db.Decimal(5, 2)
  dataVencimento      DateTime                  @db.Date
  status              PaymentStatus             @default(PENDENTE)
  dataPagamento       DateTime?
  comprovanteUrl      String?
  reciboPdfUrl        String?
  createdAt           DateTime                  @default(now())

  sale                Sale                      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user                User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([userId, status])
  @@map("commission_splits")
}

// Módulo ERP - Fluxo de Caixa Integrado
model CashFlow {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  tipo            CashFlowType      // RECEITA ou DESPESA
  categoria       String            // "Comissão Venda", "Aluguel Veraneio", "Meta Ads Tráfego", "Comissão Paga", "Administrativo"
  descricao       String
  valor           Decimal           @db.Decimal(14, 2)
  dataVencimento  DateTime          @db.Date
  status          PaymentStatus     @default(PENDENTE)
  dataPagamento   DateTime?
  meioPagamento   PaymentMethod?
  isRecorrente    Boolean           @default(false)
  anexoUrl        String?

  saleId          String?           @db.Uuid
  bookingId       String?           @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale            Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  booking         SeasonBooking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([organizationId, tipo, dataVencimento])
  @@map("cash_flows")
}

// Agenda de Compromissos e Visitas
model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  userId          String            @db.Uuid
  leadId          String?           @db.Uuid
  propertyId      String?           @db.Uuid

  tipo            AppointmentType   @default(VISITA)
  titulo          String
  dataInicio      DateTime
  dataFim         DateTime
  status          AppointmentStatus @default(AGENDADO)
  resultadoVisita String?
  observacoes     String?           @db.Text
  createdAt       DateTime          @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead            Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property        Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, dataInicio])
  @@map("appointments")
}

// Logs de Auditoria do Sistema
model AuditLog {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  userId          String?       @db.Uuid
  acao            String        // "LOGIN", "CHECKIN", "REATRIBUICAO_LEAD", "CADASTRO_VENDA", "BAIXA_COMISSAO"
  entidade        String        // "Lead", "Sale", "User", "SeasonBooking"
  entidadeId      String?
  detalhes        Json?
  ipAddress       String?
  createdAt       DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
